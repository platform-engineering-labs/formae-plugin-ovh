amends "@formae/forma.pkl"

import "@ovh/compute/instance.pkl"
import "@ovh/network/privatenetwork.pkl"
import "@ovh/network/privatesubnet.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  local testNetwork = new privatenetwork.PrivateNetwork {
    label = "plugin-sdk-test-instance-network"
    name = "formae-plugin-sdk-test-instance-net-\(v.testRunID)"
    regions {
      v.region
    }
    vlanId = 100
  }
  testNetwork

  local testSubnet = new privatesubnet.PrivateSubnet {
    label = "plugin-sdk-test-instance-subnet"
    region = v.region
    network_id = testNetwork.res.id
    network = "10.0.1.0/24"
    dhcp = true
    noGateway = false
    start = "10.0.1.2"
    end = "10.0.1.254"
  }
  testSubnet

  new instance.Instance {
    label = "plugin-sdk-test-instance"
    name = "formae-plugin-sdk-test-\(v.testRunID)"
    flavorId = v.replacementFlavorID // createOnly change forces replacement
    region = v.region
    imageId = v.ubuntuImageID
    networks {
      new instance.NetworkParams {
        networkId = testSubnet.res.network_id // Use subnet resolvable to ensure subnet is created before instance
      }
    }
  }
}
