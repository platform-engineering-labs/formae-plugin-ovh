amends "@formae/forma.pkl"

import "@ovh/database/clickhouse.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new clickhouse.ClickHouse {
    label = "plugin-sdk-test-clickhouse"
    serviceName = v.serviceName
    version = "24"
    plan = "essential"
    flavor = "db1-4"
    description = "Formae conformance test ClickHouse cluster"
    nodes {
      new clickhouse.Node {
        region = v.shortRegion
      }
    }
  }
}
