amends "@formae/forma.pkl"

import "@ovh/database/service.pkl"
import "@ovh/database/user.pkl"
import "@ovh/database/kafka_topic.pkl"
import "@ovh/database/kafka_acl.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  // Kafka service
  local kafkaService = new service.Service {
    label = "plugin-sdk-test-kafkaacl-service"
    serviceName = v.serviceName
    engine = "kafka"
    version = "3.4"
    plan = "essential"
    flavor = "db1-4"
    nodes {
      new service.Node {
        region = v.region
      }
    }
  }
  kafkaService

  // Kafka user for the ACL
  local kafkaUser = new user.User {
    label = "plugin-sdk-test-kafkaacl-user"
    serviceName = v.serviceName
    engine = "kafka"
    clusterId = kafkaService.res.id
    name = "formaeacl\(v.testRunID)"
  }
  kafkaUser

  // Kafka topic for the ACL
  local kafkaTopic = new kafka_topic.KafkaTopic {
    label = "plugin-sdk-test-kafkaacl-topic"
    serviceName = v.serviceName
    clusterId = kafkaService.res.id
    name = "formae-acl-\(v.testRunID)"
    partitions = 1
    replication = 1
    minInsyncReplicas = 1
  }
  kafkaTopic

  new kafka_acl.KafkaAcl {
    label = "plugin-sdk-test-kafkaacl"
    serviceName = v.serviceName
    clusterId = kafkaService.res.id
    username = kafkaUser.res.username
    topic = "formae-acl-\(v.testRunID)"
    permission = "read"
  }
}
