amends "@formae/forma.pkl"

import "@ovh/database/mysql.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new mysql.MySQL {
    label = "plugin-sdk-test-databasemysql"
    serviceName = v.serviceName
    version = "8"
    plan = "essential"
    flavor = "db1-4"
    description = "Formae conformance test MySQL cluster (updated)"
    nodes {
      new mysql.Node {
        region = v.shortRegion
      }
    }
  }
}
