amends "@formae/forma.pkl"

import "@formae/formae.pkl"
import "@ovh/kube/cluster.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new cluster.Cluster {
    label = "plugin-sdk-test-kubecluster"
    serviceName = v.serviceName
    name = "formae-test-\(v.testRunID)"
    region = v.region
    // version intentionally omitted: OVH defaults to its latest stable patch
    // and the schema's hasProviderDefault hint lets Verify accept whatever it returns.
    updatePolicy = "NEVER_UPDATE"
  }
}
