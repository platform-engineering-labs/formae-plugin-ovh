amends "@formae/forma.pkl"

import "@ovh/database/service.pkl"
import "@ovh/database/ip_restriction.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  // PostgreSQL service for the IP restriction
  local testService = new service.Service {
    label = "plugin-sdk-test-dbiprestriction-service"
    serviceName = v.serviceName
    engine = "postgresql"
    version = "14"
    plan = "essential"
    flavor = "db1-4"
    nodes {
      new service.Node {
        region = v.region
      }
    }
  }
  testService

  new ip_restriction.IpRestriction {
    label = "plugin-sdk-test-databaseiprestriction"
    serviceName = v.serviceName
    engine = "postgresql"
    clusterId = testService.res.id
    ip = "192.0.2.0/24"
    description = "Formae conformance test IP restriction"
  }
}
