amends "@formae/forma.pkl"

import "@ovh/database/postgresql.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new postgresql.PostgreSQL {
    label = "plugin-sdk-test-postgresql"
    serviceName = v.serviceName
    version = "16"
    plan = "essential"
    flavor = "db1-4"
    description = "Formae conformance test PostgreSQL cluster"
    nodes {
      new postgresql.Node {
        region = v.shortRegion
      }
    }
  }
}
