amends "@formae/forma.pkl"

import "@ovh/network/securitygroup.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new securitygroup.SecurityGroup {
    label = "plugin-sdk-test-securitygroup"
    name = "formae-plugin-sdk-test-\(v.testRunID)"
    description = "Formae conformance test security group - updated" // description is mutable
    tags {
      "env:test"
      "managed-by:formae"
      "updated:true" // new tag added in update
    }
  }
}
