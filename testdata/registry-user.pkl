amends "@formae/forma.pkl"

import "@ovh/registry/registry.pkl"
import "@ovh/registry/user_registry.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  // Registry for the user
  local testRegistry = new registry.Registry {
    label = "plugin-sdk-test-reguser-registry"
    serviceName = v.serviceName
    name = "formae-usr-\(v.testRunID)"
    region = v.region
  }
  testRegistry

  // Registry user (all fields are createOnly, no update/replace)
  new user_registry.User {
    label = "plugin-sdk-test-registryuser"
    serviceName = v.serviceName
    registryId = testRegistry.res.id
    login = "formaetest\(v.testRunID)"
    email = "formae-test-\(v.testRunID)@example.com"
  }
}
