amends "@formae/forma.pkl"

import "@ovh/database/service.pkl"
import "@ovh/database/database.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  // PostgreSQL service for the database
  local testService = new service.Service {
    label = "plugin-sdk-test-db-service"
    serviceName = v.serviceName
    engine = "postgresql"
    version = "14"
    plan = "essential"
    flavor = "db1-4"
    nodes {
      new service.Node {
        region = v.region
      }
    }
  }
  testService

  // Database within the service (all fields are createOnly, no update/replace)
  new database.Database {
    label = "plugin-sdk-test-database"
    serviceName = v.serviceName
    engine = "postgresql"
    clusterId = testService.res.id
    name = "formae_test_\(v.testRunID)"
  }
}
