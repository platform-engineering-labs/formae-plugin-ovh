amends "@formae/forma.pkl"

import "@ovh/compute/volume.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new volume.Volume {
    label = "plugin-sdk-test-volume"
    name = "formae-plugin-sdk-test-\(v.testRunID)"
    size = 10
    region = v.region
    volumeType = "classic"
    description = "Formae conformance test volume"
  }
}
