amends "@formae/forma.pkl"

import "@ovh/database/kafka_mirror_maker.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new kafka_mirror_maker.KafkaMirrorMaker {
    label = "plugin-sdk-test-kafkamirrormaker"
    serviceName = v.serviceName
    version = "3.7"
    plan = "business"
    flavor = "db1-4"
    description = "Formae conformance test KafkaMirrorMaker cluster"
    nodes {
      new kafka_mirror_maker.Node {
        region = v.shortRegion
      }
    }
  }
}
