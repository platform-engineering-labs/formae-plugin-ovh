amends "@formae/forma.pkl"

import "@ovh/network/network.pkl"
import "@ovh/network/port.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  local testNetwork = new network.Network {
    label = "plugin-sdk-test-port-network"
    name = "formae-plugin-sdk-test-port-net-\(v.testRunID)"
    admin_state_up = true
  }
  testNetwork

  new port.Port {
    label = "plugin-sdk-test-port"
    name = "formae-plugin-sdk-test-\(v.testRunID)-updated" // name is mutable
    network_id = testNetwork.res.id
    admin_state_up = false // admin_state_up is mutable
  }
}
