amends "@formae/forma.pkl"

import "@ovh/storage/container.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new container.Container {
    label = "plugin-sdk-test-container"
    containerName = "formae-test-\(v.testRunID)"
    region = v.shortRegion
    archive = false
    containerType = "private"
  }
}
