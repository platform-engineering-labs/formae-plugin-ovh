amends "@formae/forma.pkl"

import "@ovh/database/service.pkl"
import "@ovh/database/user.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  // PostgreSQL service for the user
  local testService = new service.Service {
    label = "plugin-sdk-test-dbuser-service"
    serviceName = v.serviceName
    engine = "postgresql"
    version = "14"
    plan = "essential"
    flavor = "db1-4"
    nodes {
      new service.Node {
        region = v.region
      }
    }
  }
  testService

  new user.User {
    label = "plugin-sdk-test-databaseuser"
    serviceName = v.serviceName
    engine = "postgresql"
    clusterId = testService.res.id
    name = "formaetest\(v.testRunID)"
    roles {
      new user.Role {
        name = "login"
      }
    }
  }
}
