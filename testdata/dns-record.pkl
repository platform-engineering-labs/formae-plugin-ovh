amends "@formae/forma.pkl"

import "@ovh/dns/record.pkl" as dnsRecord

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new dnsRecord.Record {
    label = "plugin-sdk-test-dnsrecord"
    zone = v.dnsZone
    subDomain = "formae-test-\(v.testRunID)"
    fieldType = "A"
    recordTarget = "192.0.2.1"
    ttl = 300
  }
}
