amends "@formae/forma.pkl"

import "@ovh/database/mongodb.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new mongodb.MongoDB {
    label = "plugin-sdk-test-mongodb"
    serviceName = v.serviceName
    version = "7.0"
    plan = "discovery"
    flavor = "db1-2"
    description = "Formae conformance test MongoDB cluster"
    nodes {
      new mongodb.Node {
        region = v.shortRegion
      }
    }
  }
}
