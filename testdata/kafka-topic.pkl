amends "@formae/forma.pkl"

import "@ovh/database/service.pkl"
import "@ovh/database/kafka_topic.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  // Kafka service for the topic
  local kafkaService = new service.Service {
    label = "plugin-sdk-test-kafkatopic-service"
    serviceName = v.serviceName
    engine = "kafka"
    version = "3.4"
    plan = "essential"
    flavor = "db1-4"
    nodes {
      new service.Node {
        region = v.region
      }
    }
  }
  kafkaService

  new kafka_topic.KafkaTopic {
    label = "plugin-sdk-test-kafkatopic"
    serviceName = v.serviceName
    clusterId = kafkaService.res.id
    name = "formae-test-\(v.testRunID)"
    partitions = 3
    replication = 1
    minInsyncReplicas = 1
    retentionHours = 24
  }
}
