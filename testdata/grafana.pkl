amends "@formae/forma.pkl"

import "@ovh/database/grafana.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new grafana.Grafana {
    label = "plugin-sdk-test-grafana"
    serviceName = v.serviceName
    version = "9"
    plan = "essential"
    flavor = "db1-4"
    description = "Formae conformance test Grafana cluster"
    nodes {
      new grafana.Node {
        region = v.shortRegion
      }
    }
  }
}
