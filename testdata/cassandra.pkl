amends "@formae/forma.pkl"

import "@ovh/database/cassandra.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new cassandra.Cassandra {
    label = "plugin-sdk-test-cassandra"
    serviceName = v.serviceName
    version = "4"
    plan = "business"
    flavor = "db1-15"
    description = "Formae conformance test Cassandra cluster"
    nodes {
      new cassandra.Node {
        region = v.shortRegion
      }
    }
  }
}
