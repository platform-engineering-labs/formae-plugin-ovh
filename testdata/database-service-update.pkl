amends "@formae/forma.pkl"

import "@ovh/database/service.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new service.Service {
    label = "plugin-sdk-test-databaseservice"
    serviceName = v.serviceName
    engine = "postgresql"
    version = "14"
    plan = "essential"
    flavor = "db1-7" // flavor is mutable (scale up)
    description = "Formae conformance test database service - updated" // description is mutable
    nodes {
      new service.Node {
        region = v.region
      }
    }
  }
}
