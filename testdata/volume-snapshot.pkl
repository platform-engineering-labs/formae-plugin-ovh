amends "@formae/forma.pkl"

import "@ovh/compute/volume.pkl"
import "@ovh/compute/volumesnapshot.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  // Volume to snapshot
  local testVolume = new volume.Volume {
    label = "plugin-sdk-test-snapshot-volume"
    name = "formae-plugin-sdk-test-snap-vol-\(v.testRunID)"
    size = 10
    region = v.region
    volumeType = "classic"
  }
  testVolume

  new volumesnapshot.VolumeSnapshot {
    label = "plugin-sdk-test-volumesnapshot"
    volume_id = testVolume.res.id
    name = "formae-plugin-sdk-test-snapshot-\(v.testRunID)"
    description = "Formae conformance test snapshot"
  }
}
