/// OVH M3DB Namespace
module ovh.database.m3db_namespace

import "@formae/formae.pkl"
import "../ovh.pkl"

const type = "OVH::Database::M3DBNamespace"

open class M3DBNamespaceResolvable extends formae.Resolvable {
  hidden type = module.type
  hidden id: M3DBNamespaceResolvable = (this) { property = "id" }
  hidden name: M3DBNamespaceResolvable = (this) { property = "name" }
}

@ovh.ResourceHint {
  type = module.type
  identifier = "id"
}
open class M3DBNamespace extends formae.Resource {
  hidden parent = this

  @ovh.FieldHint { required = true; createOnly = true }
  serviceName: String

  @ovh.FieldHint { required = true; createOnly = true }
  clusterId: (String|formae.Resolvable)

  @ovh.FieldHint { required = true; createOnly = true }
  name: String

  resolution: String?
  retention: String?
  snapshotEnabled: Boolean?
  writesToCommitLogEnabled: Boolean?

  @ovh.FieldHint { hasProviderDefault = true }
  id: String?

  hidden res: M3DBNamespaceResolvable = new {
    label = parent.label
    stack = parent.stack?.label
  }
}
