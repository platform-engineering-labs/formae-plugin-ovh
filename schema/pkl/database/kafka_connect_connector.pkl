/// OVH KafkaConnect Connector
module ovh.database.kafka_connect_connector

import "@formae/formae.pkl"
import "../ovh.pkl"

const type = "OVH::Database::KafkaConnectConnector"

open class KafkaConnectConnectorResolvable extends formae.Resolvable {
  hidden type = module.type
  hidden id: KafkaConnectConnectorResolvable = (this) { property = "id" }
}

@ovh.ResourceHint {
  type = module.type
  identifier = "id"
}
open class KafkaConnectConnector extends formae.Resource {
  hidden parent = this

  @ovh.FieldHint { required = true; createOnly = true }
  serviceName: String

  @ovh.FieldHint { required = true; createOnly = true }
  clusterId: (String|formae.Resolvable)

  @ovh.FieldHint { required = true; createOnly = true }
  name: String

  @ovh.FieldHint { required = true; createOnly = true }
  connectorId: String

  @ovh.FieldHint { required = true }
  configuration: Mapping<String, String>

  @ovh.FieldHint { hasProviderDefault = true }
  id: String?

  hidden res: KafkaConnectConnectorResolvable = new {
    label = parent.label
    stack = parent.stack?.label
  }
}
