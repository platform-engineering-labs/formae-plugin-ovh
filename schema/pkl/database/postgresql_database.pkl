/// OVH PostgreSQL Database (schema within cluster)
module ovh.database.postgresql_database

import "@formae/formae.pkl"
import "../ovh.pkl"

const type = "OVH::Database::PostgreSQLDatabase"

open class PostgreSQLDatabaseResolvable extends formae.Resolvable {
  hidden type = module.type
  hidden id: PostgreSQLDatabaseResolvable = (this) { property = "id" }
  hidden name: PostgreSQLDatabaseResolvable = (this) { property = "name" }
}

@ovh.ResourceHint {
  type = module.type
  identifier = "id"
}
open class PostgreSQLDatabase extends formae.Resource {
  hidden parent = this

  @ovh.FieldHint { required = true; createOnly = true }
  serviceName: String

  @ovh.FieldHint { required = true; createOnly = true }
  clusterId: (String|formae.Resolvable)

  @ovh.FieldHint { required = true; createOnly = true }
  name: String

  @ovh.FieldHint { hasProviderDefault = true }
  id: String?
  @ovh.FieldHint { hasProviderDefault = true }
  default: Boolean?

  hidden res: PostgreSQLDatabaseResolvable = new {
    label = parent.label
    stack = parent.stack?.label
  }
}
