/// OVH ClickHouse Database (schema within cluster)
module ovh.database.clickhouse_database

import "@formae/formae.pkl"
import "../ovh.pkl"

const type = "OVH::Database::ClickHouseDatabase"

open class ClickHouseDatabaseResolvable extends formae.Resolvable {
  hidden type = module.type
  hidden id: ClickHouseDatabaseResolvable = (this) { property = "id" }
  hidden name: ClickHouseDatabaseResolvable = (this) { property = "name" }
}

@ovh.ResourceHint {
  type = module.type
  identifier = "id"
}
open class ClickHouseDatabase extends formae.Resource {
  hidden parent = this

  @ovh.FieldHint { required = true; createOnly = true }
  serviceName: String

  @ovh.FieldHint { required = true; createOnly = true }
  clusterId: (String|formae.Resolvable)

  @ovh.FieldHint { required = true; createOnly = true }
  name: String

  @ovh.FieldHint { hasProviderDefault = true }
  id: String?
  @ovh.FieldHint { hasProviderDefault = true }
  default: Boolean?

  hidden res: ClickHouseDatabaseResolvable = new {
    label = parent.label
    stack = parent.stack?.label
  }
}
