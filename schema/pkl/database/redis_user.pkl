/// OVH Redis User
module ovh.database.redis_user

import "@formae/formae.pkl"
import "../ovh.pkl"

const type = "OVH::Database::RedisUser"

open class RedisUserResolvable extends formae.Resolvable {
  hidden type = module.type
  hidden id: RedisUserResolvable = (this) { property = "id" }
  hidden username: RedisUserResolvable = (this) { property = "username" }
  hidden password: RedisUserResolvable = (this) { property = "password" }
}

@ovh.ResourceHint {
  type = module.type
  identifier = "id"
}
open class RedisUser extends formae.Resource {
  hidden parent = this

  @ovh.FieldHint { required = true; createOnly = true }
  serviceName: String

  @ovh.FieldHint { required = true; createOnly = true }
  clusterId: (String|formae.Resolvable)

  @ovh.FieldHint { required = true; createOnly = true }
  name: String

  @ovh.FieldHint { hasProviderDefault = true }
  id: String?
  @ovh.FieldHint { hasProviderDefault = true }
  username: String?
  @ovh.FieldHint { hasProviderDefault = true }
  password: String?
  @ovh.FieldHint { hasProviderDefault = true }
  createdAt: String?
  @ovh.FieldHint { hasProviderDefault = true }
  status: String?

  hidden res: RedisUserResolvable = new {
    label = parent.label
    stack = parent.stack?.label
  }
}
