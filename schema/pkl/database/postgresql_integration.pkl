/// OVH PostgreSQL Integration
module ovh.database.postgresql_integration

import "@formae/formae.pkl"
import "../ovh.pkl"

const type = "OVH::Database::PostgreSQLIntegration"

open class PostgreSQLIntegrationResolvable extends formae.Resolvable {
  hidden type = module.type
  hidden id: PostgreSQLIntegrationResolvable = (this) { property = "id" }
}

@ovh.ResourceHint {
  type = module.type
  identifier = "id"
}
open class PostgreSQLIntegration extends formae.Resource {
  hidden parent = this

  @ovh.FieldHint { required = true; createOnly = true }
  serviceName: String

  @ovh.FieldHint { required = true; createOnly = true }
  clusterId: (String|formae.Resolvable)

  @ovh.FieldHint { required = true; createOnly = true }
  type: String

  @ovh.FieldHint { required = true; createOnly = true }
  destinationServiceId: (String|formae.Resolvable)

  @ovh.FieldHint { required = true; createOnly = true }
  sourceServiceId: (String|formae.Resolvable)

  parameters: Mapping<String, String>?

  @ovh.FieldHint { hasProviderDefault = true }
  id: String?
  @ovh.FieldHint { hasProviderDefault = true }
  status: String?

  hidden res: PostgreSQLIntegrationResolvable = new {
    label = parent.label
    stack = parent.stack?.label
  }
}
