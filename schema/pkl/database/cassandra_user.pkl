/// OVH Cassandra User
module ovh.database.cassandra_user

import "@formae/formae.pkl"
import "../ovh.pkl"

const type = "OVH::Database::CassandraUser"

open class CassandraUserResolvable extends formae.Resolvable {
  hidden type = module.type
  hidden id: CassandraUserResolvable = (this) { property = "id" }
  hidden username: CassandraUserResolvable = (this) { property = "username" }
  hidden password: CassandraUserResolvable = (this) { property = "password" }
}

@ovh.ResourceHint {
  type = module.type
  identifier = "id"
}
open class CassandraUser extends formae.Resource {
  hidden parent = this

  @ovh.FieldHint { required = true; createOnly = true }
  serviceName: String

  @ovh.FieldHint { required = true; createOnly = true }
  clusterId: (String|formae.Resolvable)

  @ovh.FieldHint { required = true; createOnly = true }
  name: String

  @ovh.FieldHint { hasProviderDefault = true }
  id: String?
  @ovh.FieldHint { hasProviderDefault = true }
  username: String?
  @ovh.FieldHint { hasProviderDefault = true }
  password: String?
  @ovh.FieldHint { hasProviderDefault = true }
  createdAt: String?
  @ovh.FieldHint { hasProviderDefault = true }
  status: String?

  hidden res: CassandraUserResolvable = new {
    label = parent.label
    stack = parent.stack?.label
  }
}
