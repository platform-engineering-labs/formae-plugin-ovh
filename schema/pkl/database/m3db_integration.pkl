/// OVH M3DB Integration
module ovh.database.m3db_integration

import "@formae/formae.pkl"
import "../ovh.pkl"

const type = "OVH::Database::M3DBIntegration"

open class M3DBIntegrationResolvable extends formae.Resolvable {
  hidden type = module.type
  hidden id: M3DBIntegrationResolvable = (this) { property = "id" }
}

@ovh.ResourceHint {
  type = module.type
  identifier = "id"
}
open class M3DBIntegration extends formae.Resource {
  hidden parent = this

  @ovh.FieldHint { required = true; createOnly = true }
  serviceName: String

  @ovh.FieldHint { required = true; createOnly = true }
  clusterId: (String|formae.Resolvable)

  @ovh.FieldHint { required = true; createOnly = true }
  type: String

  @ovh.FieldHint { required = true; createOnly = true }
  destinationServiceId: (String|formae.Resolvable)

  @ovh.FieldHint { required = true; createOnly = true }
  sourceServiceId: (String|formae.Resolvable)

  parameters: Mapping<String, String>?

  @ovh.FieldHint { hasProviderDefault = true }
  id: String?
  @ovh.FieldHint { hasProviderDefault = true }
  status: String?

  hidden res: M3DBIntegrationResolvable = new {
    label = parent.label
    stack = parent.stack?.label
  }
}
