/// OVH MongoDB IP Restriction
module ovh.database.mongodb_ip_restriction

import "@formae/formae.pkl"
import "../ovh.pkl"

const type = "OVH::Database::MongoDBIpRestriction"

open class MongoDBIpRestrictionResolvable extends formae.Resolvable {
  hidden type = module.type
  hidden ip: MongoDBIpRestrictionResolvable = (this) { property = "ip" }
}

@ovh.ResourceHint {
  type = module.type
  identifier = "ip"
}
open class MongoDBIpRestriction extends formae.Resource {
  hidden parent = this

  @ovh.FieldHint { required = true; createOnly = true }
  serviceName: String

  @ovh.FieldHint { required = true; createOnly = true }
  clusterId: (String|formae.Resolvable)

  @ovh.FieldHint { required = true; createOnly = true }
  ip: String

  description: String?

  @ovh.FieldHint { hasProviderDefault = true }
  status: String?

  hidden res: MongoDBIpRestrictionResolvable = new {
    label = parent.label
    stack = parent.stack?.label
  }
}
