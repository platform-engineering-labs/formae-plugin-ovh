/// OVH M3DB User
module ovh.database.m3db_user

import "@formae/formae.pkl"
import "../ovh.pkl"

const type = "OVH::Database::M3DBUser"

open class M3DBUserResolvable extends formae.Resolvable {
  hidden type = module.type
  hidden id: M3DBUserResolvable = (this) { property = "id" }
  hidden username: M3DBUserResolvable = (this) { property = "username" }
  hidden password: M3DBUserResolvable = (this) { property = "password" }
}

@ovh.ResourceHint {
  type = module.type
  identifier = "id"
}
open class M3DBUser extends formae.Resource {
  hidden parent = this

  @ovh.FieldHint { required = true; createOnly = true }
  serviceName: String

  @ovh.FieldHint { required = true; createOnly = true }
  clusterId: (String|formae.Resolvable)

  @ovh.FieldHint { required = true; createOnly = true }
  name: String

  @ovh.FieldHint { hasProviderDefault = true }
  id: String?
  @ovh.FieldHint { hasProviderDefault = true }
  username: String?
  @ovh.FieldHint { hasProviderDefault = true }
  password: String?
  @ovh.FieldHint { hasProviderDefault = true }
  createdAt: String?
  @ovh.FieldHint { hasProviderDefault = true }
  status: String?

  hidden res: M3DBUserResolvable = new {
    label = parent.label
    stack = parent.stack?.label
  }
}
