/// OVH Managed MySQL Cluster
/// API: POST /cloud/project/{serviceName}/database/mysql
module ovh.database.mysql

import "@formae/formae.pkl"
import "../ovh.pkl"

const type = "OVH::Database::MySQL"

/// MySQL service plan tiers
typealias Plan = "essential"|"business"|"enterprise"

typealias ServiceStatus = "CREATING"|"READY"|"PENDING"|"MAINTENANCE"|"ERROR"|"DELETING"

open class MySQLResolvable extends formae.Resolvable {
  hidden type = module.type

  hidden id: MySQLResolvable = (this) { property = "id" }

  hidden endpoints: MySQLResolvable = (this) { property = "endpoints" }
}

@ovh.SubResourceHint
open class Node extends formae.SubResource {
  @ovh.FieldHint { required = true; createOnly = true }
  region: String

  @ovh.FieldHint { createOnly = true }
  networkId: String?

  @ovh.FieldHint { createOnly = true }
  subnetId: String?

  // === Computed/Output fields populated by the API after creation ===

  @ovh.FieldHint { hasProviderDefault = true }
  id: String?

  @ovh.FieldHint { hasProviderDefault = true }
  name: String?

  @ovh.FieldHint { hasProviderDefault = true }
  flavor: String?

  @ovh.FieldHint { hasProviderDefault = true }
  port: Int?

  @ovh.FieldHint { hasProviderDefault = true }
  status: String?

  @ovh.FieldHint { hasProviderDefault = true }
  createdAt: String?

  @ovh.FieldHint { hasProviderDefault = true }
  role: String?
}

@ovh.SubResourceHint
open class Backup extends formae.SubResource {
  regions: Listing<String>?
  time: String?
}

@ovh.SubResourceHint
open class Disk extends formae.SubResource {
  size: Int?

  @ovh.FieldHint { hasProviderDefault = true }
  type: String?
}

@ovh.SubResourceHint
open class Endpoint extends formae.SubResource {
  @ovh.FieldHint { hasProviderDefault = true }
  component: String?

  @ovh.FieldHint { hasProviderDefault = true }
  domain: String?

  @ovh.FieldHint { hasProviderDefault = true }
  path: String?

  @ovh.FieldHint { hasProviderDefault = true }
  port: Int?

  @ovh.FieldHint { hasProviderDefault = true }
  scheme: String?

  @ovh.FieldHint { hasProviderDefault = true }
  ssl: Boolean?

  @ovh.FieldHint { hasProviderDefault = true }
  sslMode: String?

  @ovh.FieldHint { hasProviderDefault = true }
  uri: String?
}

@ovh.ResourceHint {
  type = module.type
  identifier = "id"
}
open class MySQL extends formae.Resource {
  hidden parent = this

  /// Cloud project service name (project ID)
  @ovh.FieldHint { required = true; createOnly = true }
  serviceName: String

  /// Engine version (e.g., "8")
  @ovh.FieldHint { required = true }
  version: String

  /// Service plan tier
  @ovh.FieldHint { required = true }
  plan: Plan

  /// Node flavor (compute/memory configuration)
  @ovh.FieldHint { required = true }
  flavor: String

  /// Cluster nodes configuration (minimum 1 node required)
  @ovh.FieldHint { required = true }
  nodes: Listing<Node>

  description: String?

  disk: Disk?

  backup: Backup?

  maintenanceTime: String?

  deletionProtection: Boolean?

  advancedConfiguration: Mapping<String, String>?

  // === Computed/Output fields ===

  @ovh.FieldHint { hasProviderDefault = true }
  id: String?

  @ovh.FieldHint { hasProviderDefault = true }
  createdAt: String?

  @ovh.FieldHint { hasProviderDefault = true }
  status: ServiceStatus?

  @ovh.FieldHint { hasProviderDefault = true }
  networkType: String?

  @ovh.FieldHint { hasProviderDefault = true }
  endpoints: Listing<Endpoint>?

  hidden res: MySQLResolvable = new {
    label = parent.label
    stack = parent.stack?.label
  }
}
