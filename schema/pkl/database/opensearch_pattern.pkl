/// OVH OpenSearch Index Pattern
module ovh.database.opensearch_pattern

import "@formae/formae.pkl"
import "../ovh.pkl"

const type = "OVH::Database::OpenSearchPattern"

open class OpenSearchPatternResolvable extends formae.Resolvable {
  hidden type = module.type
  hidden id: OpenSearchPatternResolvable = (this) { property = "id" }
}

@ovh.ResourceHint {
  type = module.type
  identifier = "id"
}
open class OpenSearchPattern extends formae.Resource {
  hidden parent = this

  @ovh.FieldHint { required = true; createOnly = true }
  serviceName: String

  @ovh.FieldHint { required = true; createOnly = true }
  clusterId: (String|formae.Resolvable)

  @ovh.FieldHint { required = true; createOnly = true }
  pattern: String

  maxIndexCount: Int?

  @ovh.FieldHint { hasProviderDefault = true }
  id: String?

  hidden res: OpenSearchPatternResolvable = new {
    label = parent.label
    stack = parent.stack?.label
  }
}
